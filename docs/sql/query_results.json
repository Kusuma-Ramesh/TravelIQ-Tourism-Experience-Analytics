      "title": "Rating distribution (1-5 stars)",
      "purpose": "How skewed is satisfaction? Needed context before trusting any single average-rating figure.",
      "sql": "SELECT\n    Rating,\n    COUNT(*)                                                           AS n,\n    ROUND(100.0 * COUNT(*) / (SELECT COUNT(*) FROM fact_transaction), 2) AS pct\nFROM fact_transaction\nGROUP BY Rating\nORDER BY Rating;",
