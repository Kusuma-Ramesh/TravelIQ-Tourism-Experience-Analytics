      "sql": "SELECT\n    a.Attraction   AS attraction,\n    COUNT(*)       AS n_ratings,\n    ROUND(AVG(f.Rating), 3) AS avg_rating\nFROM fact_transaction f\nJOIN dim_attraction a ON a.AttractionId = f.AttractionId\nGROUP BY a.Attraction\nHAVING COUNT(*) >= 50\nORDER BY avg_rating DESC;",
